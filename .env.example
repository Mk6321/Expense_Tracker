# ---------- Backend (backend/.env) ----------
# Supabase: use the POOLED connection string (pgbouncer, transaction mode, port 6543)
# Driver must be postgresql+asyncpg
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Alembic needs a DIRECT (non-pooled, port 5432) connection for migrations
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=900
JWT_REFRESH_TOKEN_EXPIRE=1209600

CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
COOKIE_SECURE=true
COOKIE_SAMESITE=none

INVITE_CODE_EXPIRE_DAYS=7
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-side-only-never-expose-to-frontend

# ---------- Frontend (frontend/.env) ----------
VITE_API_BASE_URL=http://localhost:8000
