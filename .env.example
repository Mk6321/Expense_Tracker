# ---------- Backend (backend/.env) ----------

# Supabase gives you three connection strings. Which one you use matters:
#
#   Direct       db.<ref>.supabase.co:5432          IPv6-ONLY on current projects.
#                                                   Render's free tier has no IPv6
#                                                   outbound, so this WILL fail there.
#   Transaction  aws-0-<region>.pooler...:6543      IPv4. Use for the running app.
#   Session      aws-0-<region>.pooler...:5432      IPv4. Use for Alembic migrations.
#
# Find them in the dashboard under Connect. Note the pooler username is
# postgres.<project-ref>, not plain "postgres".

# App runtime -- transaction pooler (pgbouncer).
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres

# Alembic -- session pooler. Transaction mode cannot run DDL reliably.
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://postgres.<project-ref>:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=900
JWT_REFRESH_TOKEN_EXPIRE=1209600

# Comma-separated. Never "*" -- credentials are required for the refresh cookie.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
COOKIE_SECURE=true
COOKIE_SAMESITE=none

INVITE_CODE_EXPIRE_DAYS=7
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-side-only-never-expose-to-frontend

# ---------- Frontend (frontend/.env) ----------
VITE_API_BASE_URL=http://localhost:8000

# ---------- Running the tests against real Postgres ----------
# TEST_DB_SCHEMA confines the run to its own schema, so drop_all can never reach
# a schema holding real data.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:PW@aws-0-<region>.pooler.supabase.com:5432/postgres
# TEST_DB_SCHEMA=expense_test
